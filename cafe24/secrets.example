# 카페24 접속 정보 — 이 파일을 cafe24/.secrets 로 복사해서 채워요 (git 에 안 올라가요)
# 카페24 관리 화면 > 나의 서비스 관리 > 호스팅 관리 에서 확인

# 사이트 주소 (카페24가 준 기본 도메인, 예: https://jandi.cafe24.com)
SITE_URL=https://

# 카페24 서버 IP (도메인을 옮기기 전에 직접 접속할 때)
SITE_IP=

# FTP (보통 주소는 아이디.cafe24.com, 아이디·비밀번호는 호스팅 아이디·FTP 비밀번호)
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_DIR=www

# DB (보통 DB 이름 = 아이디, DB 아이디 = 아이디, 비밀번호는 DB 비밀번호)
DB_NAME=
DB_USER=
DB_PASS=
