# ============================================================
#  ScoreShift — 환경 변수 설정
#  이 파일을 복사해서 .env 로 이름을 변경하고 값을 입력하세요
#  cp .env.example .env
# ============================================================

# 제미나이로 악보 읽기 (있으면 업로드할 때 Tesseract 대신 제미나이로 읽음)
# https://aistudio.google.com/apikey 에서 무료로 발급
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Anthropic API 키 (선택: 조 변환 기능의 Claude Vision 악보 분석에 사용.
# 라이브러리의 제목/가사/코드 자동 인식은 로컬 Tesseract OCR을 쓰므로 이 키가 없어도 동작합니다)


# https://console.anthropic.com/settings/keys 에서 발급
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# 서버 설정 (선택)
HOST=0.0.0.0
PORT=8000
RELOAD=true

# CORS 허용 출처 (선택, 기본: *)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500



# ── 공유용 비밀번호 로그인 (서버에 올려서 여러 명이 쓸 때 꼭 설정) ──
# APP_PASSWORD   : 팀원 비밀번호 — 검색, 악보 보기, 새 콘티 PDF 내보내기, 필기
# ADMIN_PASSWORD : 관리자 비밀번호(선택) — 업로드, 제목/키 수정, 곡 나누기, 삭제
#                  비워두면 APP_PASSWORD로 들어온 사람이 모든 기능을 쓸 수 있어요.
# 둘 다 비워두면 로그인 없이 열려요 (내 컴퓨터에서만 쓸 때).
# 비밀번호를 바꾸면 모든 사람의 로그인이 풀려요.
APP_PASSWORD=
ADMIN_PASSWORD=
# SECRET_KEY=아무-긴-무작위-문자열   (선택: 비밀번호를 바꿔도 로그인 유지하고 싶을 때)
